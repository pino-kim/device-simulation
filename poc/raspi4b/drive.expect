#!/usr/bin/expect -f
# raspi4b(BCM2711) 부팅 → 로그인 → rootfs에 주입된 테스트 실행 → result.txt 기록 → 종료
# (바이너리/테스트는 부팅 전에 SD rootfs로 주입돼 있음 — 9p 불필요)
set timeout 300
set Q      [expr {[info exists env(QEMU_BIN)] ? $env(QEMU_BIN) : "/workdir/qemu-install/bin/qemu-system-aarch64"}]
set KERNEL "/workdir/build/tmp/deploy/images/raspberrypi4-64/Image-raspberrypi4-64.bin"
set DTB    "/workdir/build/tmp/deploy/images/raspberrypi4-64/bcm2711-rpi-4-b-qemu-console.dtb"
set SD     "/workdir/poc/raspi4b/rpi4b-test.wic"

spawn $Q -M raspi4b -cpu cortex-a72 -m 2G -nographic -no-reboot \
    -kernel $KERNEL -dtb $DTB \
    -drive file=$SD,format=raw,if=sd \
    -append "console=ttyAMA0,115200 earlycon=pl011,0xfe201000 root=/dev/mmcblk1p2 rootwait rw"

expect {
    timeout { puts "\nRESULT_FAIL: login timeout"; exit 2 }
    -re "login:" {}
}
send "root\r"

expect {
    timeout { puts "\nRESULT_FAIL: shell prompt timeout"; exit 3 }
    -re {root@[^#]*# } {}
    -re "# " {}
}

send "sh /home/root/hosttest/run-tests.sh > /home/root/hosttest/result.txt 2>&1; echo TESTS_DONE\r"
expect {
    timeout { puts "\nRESULT_FAIL: tests timeout"; exit 5 }
    "TESTS_DONE" {}
}

send "sync; poweroff\r"
expect {
    timeout { puts "\nRESULT_WARN: poweroff timeout" }
    eof {}
}
puts "\nRESULT_OK: raspi4b PoC done"
