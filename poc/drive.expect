#!/usr/bin/expect -f
# QEMU로 보드 rootfs 부팅 → 로그인 → 9p 마운트 → 테스트 실행 → 결과 회수 → 종료
# (Tcl 대괄호는 명령치환이므로 메시지에 [] 쓰지 말 것)
set timeout 300
set Q      "/workdir/qemu-install/bin/qemu-system-aarch64"
set KERNEL "/workdir/build/tmp/deploy/images/raspberrypi4-64/Image-raspberrypi4-64.bin"
set WIC    "/workdir/rpi4.wic"
set SHARE  "/workdir/poc/testshare"

spawn $Q -M virt -cpu cortex-a72 -m 2048 -smp 4 -nographic -no-reboot \
    -kernel $KERNEL \
    -append "root=/dev/vda2 rootwait rw console=ttyAMA0 earlycon=pl011,0x9000000" \
    -drive file=$WIC,format=raw,if=none,id=hd0 -device virtio-blk-pci,drive=hd0 \
    -fsdev local,id=fs0,path=$SHARE,security_model=none -device virtio-9p-pci,fsdev=fs0,mount_tag=hostshare

# 1) 로그인 프롬프트 대기
expect {
    timeout { puts "\nRESULT_FAIL: login timeout"; exit 2 }
    -re "login:" {}
}
send "root\r"

# 2) 루트 셸 프롬프트 대기 (core-image-base root는 비번 없음)
expect {
    timeout { puts "\nRESULT_FAIL: shell prompt timeout"; exit 3 }
    -re {root@[^#]*# } {}
    -re "# " {}
}

# 3) 9p 호스트 공유 마운트 후 테스트 실행 (결과를 공유폴더 result.txt로 회수)
send "mkdir -p /mnt/host && mount -t 9p -o trans=virtio,version=9p2000.L hostshare /mnt/host && echo MOUNT_OK\r"
expect {
    timeout { puts "\nRESULT_FAIL: 9p mount timeout"; exit 4 }
    "MOUNT_OK" {}
    "mount:" { puts "\nRESULT_FAIL: 9p mount error"; exit 4 }
}

send "sh /mnt/host/run-tests.sh 2>&1 | tee /mnt/host/result.txt; echo TESTS_DONE\r"
expect {
    timeout { puts "\nRESULT_FAIL: tests timeout"; exit 5 }
    "TESTS_DONE" {}
}

# 4) 정상 종료
send "sync; poweroff\r"
expect {
    timeout { puts "\nRESULT_WARN: poweroff timeout" }
    eof {}
}
puts "\nRESULT_OK: PoC done -> poc/testshare/result.txt"
