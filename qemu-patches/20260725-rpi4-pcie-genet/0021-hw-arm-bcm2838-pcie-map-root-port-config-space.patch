From: Codex <codex@local>
Date: Thu, 30 Jul 2026 00:00:00 +0900
Subject: [PATCH 21/21] hw/arm/bcm2838_pcie: map root port config space

The BCM2711 driver accesses the root port's standard 4 KiB PCIe
configuration space directly through the controller register window.
The model treated offsets below 0x1000 as an unsigned out-of-range
access and returned all ones, so Linux could create the host bridge but
could not enumerate the root port or any downstream endpoint.

Route the first 4 KiB to the embedded root port PCIDevice config space.
---
 hw/arm/bcm2838_pcie.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/hw/arm/bcm2838_pcie.c b/hw/arm/bcm2838_pcie.c
--- a/hw/arm/bcm2838_pcie.c
+++ b/hw/arm/bcm2838_pcie.c
@@ -40,7 +40,11 @@ static uint64_t bcm2838_pcie_host_read(void *opaque, hwaddr offset,
     uint32_t *cfg_idx = (uint32_t *)(root_regs + BCM2838_PCIE_EXT_CFG_INDEX
                                      - PCIE_CONFIG_SPACE_SIZE);
 
-    if (offset - PCIE_CONFIG_SPACE_SIZE + size <= sizeof(s->root_port.regs)) {
+    if (offset + size <= PCIE_CONFIG_SPACE_SIZE) {
+        value = pci_default_read_config(PCI_DEVICE(&s->root_port),
+                                        offset, size);
+    } else if (offset - PCIE_CONFIG_SPACE_SIZE + size
+               <= sizeof(s->root_port.regs)) {
         switch (offset) {
         case BCM2838_PCIE_EXT_CFG_DATA
             ... BCM2838_PCIE_EXT_CFG_DATA + PCIE_CONFIG_SPACE_SIZE - 1:
@@ -69,7 +73,11 @@ static void bcm2838_pcie_host_write(void *opaque, hwaddr offset,
 
     trace_bcm2838_pcie_host_write(size, offset, value);
 
-    if (offset - PCIE_CONFIG_SPACE_SIZE + size <= sizeof(s->root_port.regs)) {
+    if (offset + size <= PCIE_CONFIG_SPACE_SIZE) {
+        pci_default_write_config(PCI_DEVICE(&s->root_port),
+                                 offset, value, size);
+    } else if (offset - PCIE_CONFIG_SPACE_SIZE + size
+               <= sizeof(s->root_port.regs)) {
         switch (offset) {
         case BCM2838_PCIE_EXT_CFG_DATA
             ... BCM2838_PCIE_EXT_CFG_DATA + PCIE_CONFIG_SPACE_SIZE - 1:
-- 
